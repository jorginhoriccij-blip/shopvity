rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shopvity ──
    match /shopvity_empresas/{lojaId} {
      allow read: if true;
      allow write: if request.auth.uid == lojaId;
      match /anuncios/{prodId} {
        allow read: if true;
        allow write: if request.auth.uid == lojaId;
      }
      match /pedidos/{pedId} {
        allow read, write: if request.auth.uid == lojaId;
      }
    }

    // ── ImobConnect ──
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /imoveis/{imovelId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null;
    }

  }
}
